
# Copy this file to .env. Never commit .env or paste its contents into chat.
# Supabase > Connect > Session pooler (port 5432). Percent-encode the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
# After provision-runtime, DATABASE_URL uses a restricted app login and the
# original owner URL is saved locally as MIGRATION_DATABASE_URL for CLI commands.
# Generate locally: .\.venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=replace-with-a-random-secret
APP_ENV=development
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
SESSION_HOURS=8
# Optional: built frontend directory for a single-origin deployment.
# FRONTEND_DIST=frontend/dist
# Deployment launcher only: listening port and explicitly trusted proxy IPs.
# PORT=8000
# FORWARDED_ALLOW_IPS=
# Optional. No requests are sent to CarsXE without a key.
CARSXE_API_KEY=
# Optional broad vehicle coverage; backend-only key. Free images have a watermark.
CARIMAGES_API_KEY=
# Optional private API secret for exact make/model catalog matching.
CARIMAGES_API_SECRET=
# Reviewed real-photo registry and three bundled real category photos.
FREE_VEHICLE_PHOTOS=true
# Additional reviewed HTTPS hosts allowed for PDF fetching.
# Registry images are already permitted; unavailable images use real category photos.
IMAGE_DOWNLOAD_HOSTS=[]
