# Supply actual secrets through your hosting secret manager, never commit them.
APP_ENV=production
DATABASE_URL=postgresql://smartsauda_app:ENCODED_RUNTIME_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
APP_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=["https://YOUR_APP_HOST"]
# Loopback is needed for the container health probe.
ALLOWED_HOSTS=["YOUR_APP_HOST","127.0.0.1"]
FRONTEND_DIST=/app/frontend/dist
PORT=8000
SESSION_HOURS=8
# Exact trusted reverse-proxy addresses, determined from the selected host.
# Leave empty for direct local connections. Never accept spoofed client headers.
FORWARDED_ALLOW_IPS=
# Optional: no key means explicit vehicle placeholders.
CARSXE_API_KEY=
IMAGE_DOWNLOAD_HOSTS=[]
# Do NOT put MIGRATION_DATABASE_URL in the web application's environment.
