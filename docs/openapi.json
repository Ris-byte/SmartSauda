            "minLength": 1,
            "title": "Brand"
          },
          "model": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Model"
          },
          "manufacture_year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 1900.0,
            "title": "Manufacture Year"
          },
          "km_driven": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Km Driven",
            "ge": 0,
            "le": 10000000
          },
          "engine_capacity_cc": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "ge": 0,
                "le": 50000
              },
              {
                "type": "null"
              }
            ],
            "title": "Engine Capacity Cc"
          },
          "owner_count": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 4.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Owner Count"
          },
          "motor_power_kw": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "integer"
                  }
                ],
                "gt": 0,
                "le": 10000
              },
              {
                "type": "null"
              }
            ],
            "title": "Motor Power Kw"
          },
